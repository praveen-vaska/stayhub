# StayHub Environment Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=stayhub_accommodation_super_secret_jwt_key_2026

# Database Configuration
# Optional: Provide a MongoDB Atlas / Local MongoDB connection string.
# If omitted or un-routable, StayHub automatically runs on the integrated, high-speed unified storage engine!
MONGODB_URI=mongodb://localhost:27017/stayhub_db

# Google Maps API (Optional: Used for advanced client JS Geocoding / StreetView if enabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudinary (Optional: For cloud image storage if configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
